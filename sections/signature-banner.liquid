{%- liquid
  assign signature_collection = section.settings.collection
  assign signature_image = section.settings.image | default: signature_collection.image | default: signature_collection.featured_image
  assign signature_url = signature_collection.url
  if signature_url == blank
    assign signature_url = routes.collections_url | append: '/signature'
  endif
-%}

{%- style -%}
  .signature-banner__wrapper {
    padding-bottom: 3.6rem;
  }

  .signature-banner__panel {
    position: relative;
    display: grid;
    align-items: end;
    aspect-ratio: 3 / 1;
    min-height: 32rem;
    overflow: hidden;
    border: 1px solid #e9e2d6;
    background: #ede4d6;
  }

  .signature-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .signature-banner__panel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(237, 228, 214, 0.65), transparent 45%);
    pointer-events: none;
  }

  .signature-banner__content {
    position: relative;
    z-index: 1;
    width: 42%;
    padding: clamp(2.8rem, 4vw, 6.4rem);
    color: #2b211a;
    font-family: 'Bodoni Moda', 'Times New Roman', serif;
  }

  .signature-banner__label {
    margin: 0 0 1.6rem;
    font-size: 1.2rem;
    letter-spacing: 0.4em;
    line-height: 1.5;
  }

  .signature-banner__label::after {
    content: '';
    display: block;
    width: 6rem;
    height: 1px;
    margin-top: 1.2rem;
    background: #8f8173;
  }

  .signature-banner__heading {
    margin: 0 0 1.2rem;
    color: inherit;
    font-family: inherit;
    font-size: clamp(3.2rem, 4.2vw, 6.4rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .signature-banner__heading span {
    display: block;
  }

  .signature-banner__text {
    max-width: 26rem;
    margin: 0 0 2.4rem;
    font-size: 1.6rem;
    line-height: 1.35;
  }

  .signature-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
    min-height: 4.4rem;
    padding: 1.2rem 2.4rem;
    border: 1px solid #a39587;
    background: #f9f5ed;
    color: #43372e;
    font-size: 1.1rem;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .signature-banner__button:hover {
    background: #fff;
  }

  @media screen and (max-width: 989px) {
    .signature-banner__content {
      width: 50%;
    }
  }

  @media screen and (max-width: 749px) {
    .signature-banner__panel {
      aspect-ratio: auto;
      min-height: 0;
    }

    .signature-banner__image {
      position: relative;
      display: block;
      aspect-ratio: 3 / 1;
      height: auto;
    }

    .signature-banner__panel::after {
      display: none;
    }

    .signature-banner__content {
      width: 100%;
      padding: 2.4rem;
    }

    .signature-banner__heading {
      font-size: 3.6rem;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="signature-banner__wrapper page-width">
    <div class="signature-banner__panel">
      {%- if signature_image != blank -%}
        {{
          signature_image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            widths: '600, 900, 1200, 1600, 2000, 2400',
            sizes: '(min-width: 1600px) 1500px, (min-width: 750px) calc(100vw - 10rem), calc(100vw - 3rem)',
            class: 'signature-banner__image'
        }}
      {%- endif -%}
      <div class="signature-banner__content">
        <p class="signature-banner__label">{{ section.settings.label | escape }}</p>
        <h2 class="signature-banner__heading">
          <span>{{ section.settings.heading | escape }}</span>
          <span>{{ section.settings.heading_second_line | escape }}</span>
        </h2>
        <p class="signature-banner__text">{{ section.settings.text | escape }}</p>
        <a class="signature-banner__button" href="{{ signature_url | escape }}">
          <span>EXPLORE SIGNATURE</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Signature banner",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "image_picker", "id": "image", "label": "Image override" },
    { "type": "text", "id": "label", "label": "Label", "default": "SIGNATURE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Essence" },
    { "type": "text", "id": "heading_second_line", "label": "Heading second line", "default": "of GLORAC" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Timeless pieces for a more beautiful everyday." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Signature banner" }]
}
{% endschema %}
