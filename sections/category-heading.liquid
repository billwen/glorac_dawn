{%- capture localized_heading -%}{%- render 'localized-theme-text', text: section.settings.heading -%}{%- endcapture -%}
{%- style -%}
  .category-heading__row {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .category-heading__title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.6rem, 2.2vw, 3.5rem);
    margin: 0;
    color: #231811;
    text-align: center;
    font-family: 'Times New Roman', serif;
    font-size: clamp(1.8rem, 2.5vw, 4rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.18em;
    white-space: nowrap;
  }

  .category-heading__title::before,
  .category-heading__title::after {
    content: '';
    flex-shrink: 0;
    width: clamp(3.2rem, 5.6vw, 9rem);
    height: 1px;
    background: #aa998b;
  }

  @media screen and (max-width: 749px) {
    .category-heading__title {
      font-size: clamp(1.4rem, 4.6vw, 1.8rem);
      gap: 1rem;
      letter-spacing: 0.12em;
    }

    .category-heading__title::before,
    .category-heading__title::after {
      width: 2.4rem;
    }

  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="category-heading__row page-width">
    <h2 class="category-heading__title">{{ localized_heading | remove: '--' | strip | escape }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "Category heading",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Category heading"
    }
  ]
}
{% endschema %}
