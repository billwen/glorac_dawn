{{ 'section-about-editorial.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign story_label = section.settings.story_label
  assign story_heading = section.settings.story_heading
  assign story_subheading = section.settings.story_subheading
  assign story_text = section.settings.story_text
  assign story_quote = section.settings.story_quote
  assign philosophy_label = section.settings.philosophy_label
  assign philosophy_heading = section.settings.philosophy_heading
  assign philosophy_text = section.settings.philosophy_text
  assign philosophy_quote = section.settings.philosophy_quote
  assign craft_heading = section.settings.craft_heading
  assign craft_text = section.settings.craft_text
  assign craft_button = section.settings.craft_button
  assign certification_heading = section.settings.certification_heading
  assign closing_heading = section.settings.closing_heading
  assign closing_text = section.settings.closing_text
  assign closing_button = section.settings.closing_button
  if request.locale.iso_code == 'sv'
    assign story_label = 'about_editorial.story_label' | t
    assign story_heading = 'about_editorial.story_heading' | t
    assign story_subheading = 'about_editorial.story_subheading' | t
    assign story_text = 'about_editorial.story_text_html' | t
    assign story_quote = 'about_editorial.story_quote' | t
    assign philosophy_label = 'about_editorial.philosophy_label' | t
    assign philosophy_heading = 'about_editorial.philosophy_heading' | t
    assign philosophy_text = 'about_editorial.philosophy_text_html' | t
    assign philosophy_quote = 'about_editorial.philosophy_quote' | t
    assign craft_heading = 'about_editorial.craft_heading' | t
    assign craft_text = 'about_editorial.craft_text_html' | t
    assign craft_button = 'about_editorial.craft_button' | t
    assign certification_heading = 'about_editorial.certification_heading' | t
    assign closing_heading = 'about_editorial.closing_heading' | t
    assign closing_text = 'about_editorial.closing_text' | t
    assign closing_button = 'about_editorial.closing_button' | t
  endif

  # Match the image sizes to the grid padding, gaps, and maximum width in section-about-editorial.css.
  assign mobile_grid_image_size = 'calc(100vw - clamp(1.6rem, 2.5vw, 4.8rem) - clamp(1.6rem, 2.5vw, 4.8rem))'
  assign detail_image_sizes = '(min-width: 750px) calc((min(160rem, calc(100vw - clamp(1.6rem, 2.5vw, 4.8rem) - clamp(1.6rem, 2.5vw, 4.8rem))) - clamp(1.2rem, 2vw, 3.2rem) - clamp(1.2rem, 2vw, 3.2rem)) / 3), ' | append: mobile_grid_image_size
  assign certification_image_sizes = '(min-width: 750px) calc((min(160rem, calc(100vw - clamp(1.6rem, 2.5vw, 4.8rem) - clamp(1.6rem, 2.5vw, 4.8rem))) - clamp(1.6rem, 2vw, 3.2rem)) / 2), ' | append: mobile_grid_image_size

  assign hero_image = section.settings.hero_image
  assign philosophy_image = section.settings.philosophy_image | default: collections['sleep'].image | default: collections['sleep'].featured_image | default: hero_image
  assign closing_image = section.settings.closing_image | default: collections['signature'].image | default: collections['signature'].featured_image | default: hero_image
-%}

<div class="about-editorial">
  <div class="about-editorial__hero">
    {%- if hero_image != blank -%}
      {{ hero_image | image_url: width: 3840 | image_tag: widths: '320, 400, 480, 600, 750, 900, 1200, 1600, 1920, 2400, 2880, 3840', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'about-editorial__image' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'about-editorial__image about-editorial__placeholder' }}
    {%- endif -%}
  </div>

  <div class="about-editorial__story">
    <div class="about-editorial__story-heading">
      <p class="about-editorial__eyebrow">{{ story_label | escape }}</p>
      <h1 class="about-editorial__heading">{{ story_heading | escape }}<br><em>{{ story_subheading | escape }}</em></h1>
    </div>
    <div class="about-editorial__story-content">
      <div class="about-editorial__body rte">{{ story_text }}</div>
      {%- if story_quote != blank -%}
        <p class="about-editorial__quote">{{ story_quote | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="about-editorial__philosophy">
    <div class="about-editorial__philosophy-media">
      {%- if philosophy_image != blank -%}
        {{ philosophy_image | image_url: width: 2400 | image_tag: widths: '320, 400, 480, 600, 750, 900, 1100, 1200, 1500, 1800, 2000, 2400', sizes: '(min-width: 750px) 60vw, 100vw', loading: 'lazy', class: 'about-editorial__image' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'about-editorial__image about-editorial__placeholder' }}
      {%- endif -%}
    </div>
    <div class="about-editorial__philosophy-content">
      <p class="about-editorial__eyebrow">{{ philosophy_label | escape }}</p>
      <h2 class="about-editorial__heading">{{ philosophy_heading | escape }}</h2>
      <div class="about-editorial__body rte">{{ philosophy_text }}</div>
      {%- if philosophy_quote != blank -%}
        <p class="about-editorial__quote">{{ philosophy_quote | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="about-editorial__craft">
    <h2 class="about-editorial__craft-heading">{{ craft_heading | escape }}</h2>
    <div class="about-editorial__details">
      {%- for block in section.blocks -%}
        {%- assign detail_image = block.settings.image | default: block.settings.collection.image | default: block.settings.collection.featured_image -%}
        <figure class="about-editorial__detail" {{ block.shopify_attributes }}>
          <div class="about-editorial__detail-media">
            {%- if detail_image != blank -%}
              {{ detail_image | image_url: width: 1600 | image_tag: widths: '240, 320, 400, 480, 600, 750, 900, 1100, 1200, 1440, 1600', sizes: detail_image_sizes, loading: 'lazy', class: 'about-editorial__image' }}
            {%- else -%}
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'about-editorial__image about-editorial__placeholder' }}
            {%- endif -%}
          </div>
          {%- liquid
            assign detail_title = block.settings.title
            if request.locale.iso_code == 'sv'
              case block.settings.title
                when 'THE FINEST FABRICS'
                  assign detail_title = 'about_editorial.captions.finest_fabrics' | t
                when 'REFINED DETAILS'
                  assign detail_title = 'about_editorial.captions.refined_details' | t
                when 'CONSIDERED DESIGN'
                  assign detail_title = 'about_editorial.captions.considered_design' | t
                when 'LASTING BEAUTY'
                  assign detail_title = 'about_editorial.captions.lasting_beauty' | t
              endcase
            endif
          -%}
          <figcaption>{{ detail_title | escape }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
    <div class="about-editorial__body about-editorial__craft-text rte">{{ craft_text }}</div>
    {%- if craft_button != blank -%}
      <a class="about-editorial__link" href="{{ section.settings.craft_link | default: routes.all_products_collection_url | escape }}">
        <span>{{ craft_button | escape }}</span><span aria-hidden="true">&longrightarrow;</span>
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.certification_fabric_image != blank or section.settings.certification_oeko_tex_image != blank -%}
    <div class="about-editorial__certification">
      <h2 class="about-editorial__craft-heading">{{ certification_heading | escape }}</h2>
      <div class="about-editorial__certification-images">
        {%- if section.settings.certification_fabric_image != blank -%}
          {{ section.settings.certification_fabric_image | image_url: width: 1600 | image_tag: widths: '320, 400, 480, 600, 750, 900, 1100, 1200, 1440, 1600', sizes: certification_image_sizes, loading: 'lazy', class: 'about-editorial__certification-image' }}
        {%- endif -%}
        {%- if section.settings.certification_oeko_tex_image != blank -%}
          {{ section.settings.certification_oeko_tex_image | image_url: width: 1600 | image_tag: widths: '320, 400, 480, 600, 750, 900, 1100, 1200, 1440, 1600', sizes: certification_image_sizes, loading: 'lazy', class: 'about-editorial__certification-image' }}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="about-editorial__closing">
    {%- if closing_image != blank -%}
      {{ closing_image | image_url: width: 3840 | image_tag: widths: '320, 400, 480, 600, 750, 900, 1200, 1600, 1920, 2400, 2880, 3840', sizes: '100vw', loading: 'lazy', class: 'about-editorial__image' }}
    {%- endif -%}
    <div class="about-editorial__closing-content">
      <h2 class="about-editorial__heading">{{ closing_heading | escape }}</h2>
      <p class="about-editorial__body">{{ closing_text | escape }}</p>
      {%- if closing_button != blank -%}
        <a class="about-editorial__link" href="{{ section.settings.closing_link | default: routes.all_products_collection_url | escape }}">
          <span>{{ closing_button | escape }}</span><span aria-hidden="true">&longrightarrow;</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About editorial",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Hero banner"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Recommended: 1920 × 730 px. Displays without text."
    },
    {
      "type": "header",
      "content": "Our story"
    },
    {
      "type": "text",
      "id": "story_label",
      "label": "Label",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Heading",
      "default": "GLORAC began with a quiet question:"
    },
    {
      "type": "text",
      "id": "story_subheading",
      "label": "Italic heading",
      "default": "In a world that never stops, how do we return to ourselves?"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story",
      "default": "<p>We find the answer in life's softer moments: the first light of morning, the deep exhale at night, the gentle whisper of pure Mulberry silk against our skin.</p><p>From slow mornings to relaxed evenings, our loungewear, sleepwear, dresses, scarves and accessories bring comfort and effortless elegance into your everyday life.</p><p>GLORAC was born from the harmony of two ideals: <strong>GLOW</strong> and <strong>CRAFT</strong>.</p><ul><li><strong>GLOW (GLO)</strong> is the beauty, grace and peace already within you.</li><li><strong>CRAFT (RAC)</strong> is our commitment to honoring that light through timeless design, thoughtful details, and enduring quality.</li></ul><p>Our journey began with pure Mulberry silk, chosen for exceptional softness, breathability, and weightless feel.</p><p>At the heart of GLORAC is quiet luxury: elegance without excess, and quality you can feel. It lives in the graceful drape of silk, the precision of a hand-rolled edge, and the quiet pleasure of wearing something beautifully made.</p><p>Blending city sophistication with the intimacy of home, GLORAC acts as a gentle second skin—protecting your peace, revealing your natural glow, and inspiring a softer rhythm with yourself and the world around you.</p><p>More than silk, GLORAC is a daily invitation:</p>"
    },
    {
      "type": "text",
      "id": "story_quote",
      "label": "Quote",
      "default": "Slow down. Return to yourself. Wear your glow."
    },
    {
      "type": "header",
      "content": "Our philosophy"
    },
    {
      "type": "image_picker",
      "id": "philosophy_image",
      "label": "Philosophy image",
      "info": "Recommended: 1100 × 560 px (55:28). Falls back to the Sleep collection image."
    },
    {
      "type": "text",
      "id": "philosophy_label",
      "label": "Label",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "philosophy_heading",
      "label": "Heading",
      "default": "Quiet Luxury"
    },
    {
      "type": "richtext",
      "id": "philosophy_text",
      "label": "Text",
      "default": "<p>We are drawn to things that reveal their beauty slowly — natural movement, beautiful fabrics, thoughtful proportions and details that never ask for attention. GLORAC is designed for a woman who values how something feels as much as how it looks. Effortless at home. Elegant beyond it.</p>"
    },
    {
      "type": "text",
      "id": "philosophy_quote",
      "label": "Quote",
      "default": "Never overstated. Always considered."
    },
    {
      "type": "header",
      "content": "Made with intention"
    },
    {
      "type": "text",
      "id": "craft_heading",
      "label": "Heading",
      "default": "MADE WITH INTENTION"
    },
    {
      "type": "richtext",
      "id": "craft_text",
      "label": "Text",
      "default": "<p>From the drape of silk to the finish of a seam, every detail matters. We choose fabrics for their touch, movement and lasting beauty, then refine every silhouette so that it feels natural against the body.</p>"
    },
    {
      "type": "text",
      "id": "craft_button",
      "label": "Link label",
      "default": "DISCOVER OUR SILK"
    },
    {
      "type": "url",
      "id": "craft_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Certified with care"
    },
    {
      "type": "text",
      "id": "certification_heading",
      "label": "Heading",
      "default": "CERTIFIED WITH CARE"
    },
    {
      "type": "image_picker",
      "id": "certification_fabric_image",
      "label": "Fabric image"
    },
    {
      "type": "image_picker",
      "id": "certification_oeko_tex_image",
      "label": "OEKO-TEX image"
    },
    {
      "type": "header",
      "content": "Closing banner"
    },
    {
      "type": "image_picker",
      "id": "closing_image",
      "label": "Closing image",
      "info": "Recommended: 1920 × 600 px. Falls back to the Signature collection image, then the hero image."
    },
    {
      "type": "text",
      "id": "closing_heading",
      "label": "Heading",
      "default": "For the beautiful moments in between."
    },
    {
      "type": "text",
      "id": "closing_text",
      "label": "Text",
      "default": "Pieces designed for the way you live, rest, travel and celebrate."
    },
    {
      "type": "text",
      "id": "closing_button",
      "label": "Link label",
      "default": "DISCOVER GLORAC"
    },
    {
      "type": "url",
      "id": "closing_link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Intention image",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended: 600 × 360 px. Use a close-up of fabric, finishing or silhouette."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Fallback collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Caption",
          "default": "CONSIDERED DESIGN"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About editorial",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "title": "THE FINEST FABRICS"
          }
        },
        {
          "type": "detail",
          "settings": {
            "title": "REFINED DETAILS"
          }
        },
        {
          "type": "detail",
          "settings": {
            "title": "CONSIDERED DESIGN"
          }
        },
        {
          "type": "detail",
          "settings": {
            "title": "LASTING BEAUTY"
          }
        }
      ]
    }
  ]
}
{% endschema %}
