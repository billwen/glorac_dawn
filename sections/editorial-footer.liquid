{{ 'section-editorial-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shop_menu = section.settings.shop_menu | default: linklists['footer_menu_shop']
  assign about_menu = section.settings.about_menu | default: linklists['footer_menu_about']
  assign customer_care_menu = section.settings.customer_care_menu | default: linklists['footer_menu_customer_care']
  assign newsletter_id = 'FooterNewsletter-' | append: section.id
  assign social_platforms = 'instagram|pinterest|facebook|youtube' | split: '|'
  assign social_names = 'Instagram|Pinterest|Facebook|YouTube' | split: '|'
-%}

<footer class="editorial-footer">
  <div class="editorial-footer__shell page-width">
    <div class="editorial-footer__grid">
      <div class="editorial-footer__brand">
        <a class="editorial-footer__logo" href="{{ routes.root_url }}">
          <img src="{{ 'GLORAC.svg' | asset_url }}" alt="GLORAC" width="227" height="31" loading="lazy">
        </a>
        <p class="editorial-footer__tagline">{{ 'glorac.footer.tagline' | t | escape }}</p>
      </div>

      <nav class="editorial-footer__nav" aria-label="{{ 'glorac.footer.shop_label' | t | escape }}">
        <h2 class="editorial-footer__heading">{{ 'glorac.footer.shop_heading' | t | escape }}</h2>
        <ul class="editorial-footer__links" role="list">
          {%- for link in shop_menu.links -%}
            <li><a href="{{ link.url | escape }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>

      <nav class="editorial-footer__nav" aria-label="{{ 'glorac.footer.about_label' | t | escape }}">
        <h2 class="editorial-footer__heading">{{ 'glorac.footer.about_heading' | t | escape }}</h2>
        <ul class="editorial-footer__links" role="list">
          {%- for link in about_menu.links -%}
            <li><a href="{{ link.url | escape }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>

      <nav class="editorial-footer__nav" aria-label="{{ 'glorac.footer.customer_care_label' | t | escape }}">
        <h2 class="editorial-footer__heading">{{ 'glorac.footer.customer_care_heading' | t | escape }}</h2>
        <ul class="editorial-footer__links" role="list">
          {%- for link in customer_care_menu.links -%}
            <li><a href="{{ link.url | escape }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="editorial-footer__newsletter">
        <h2 class="editorial-footer__heading">{{ 'glorac.footer.newsletter_heading' | t | escape }}</h2>
        <p class="editorial-footer__newsletter-text">{{ 'glorac.footer.newsletter_text_html' | t }}</p>
        {%- form 'customer', id: newsletter_id -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="editorial-footer__email-field">
            <label class="visually-hidden" for="{{ newsletter_id }}-email">{{ 'glorac.footer.email_label' | t | escape }}</label>
            <input
              id="{{ newsletter_id }}-email"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ 'glorac.footer.email_label' | t | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="{{ newsletter_id }}-error"
              {% elsif form.posted_successfully? %}
                aria-describedby="{{ newsletter_id }}-success"
              {% endif %}
            >
            <button type="submit" name="commit" aria-label="{{ 'glorac.footer.subscribe_label' | t | escape }}">
              {% render 'icon-landing-arrow' %}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="editorial-footer__message" id="{{ newsletter_id }}-error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="editorial-footer__message" id="{{ newsletter_id }}-success" role="status">{{ 'newsletter.success' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="editorial-footer__closing">
        <p>{{ 'glorac.footer.closing_html' | t }}</p>
        <span class="editorial-footer__closing-rule" aria-hidden="true"></span>
      </div>
    </div>
    <div class="editorial-footer__bottom">
      <p class="editorial-footer__copyright">&copy; {{ 'now' | date: '%Y' }} GLORAC. {{ 'glorac.footer.copyright' | t | escape }}</p>
      <ul class="editorial-footer__social" role="list">
        {%- for platform in social_platforms -%}
          {%- liquid
            assign social_setting = 'social_' | append: platform | append: '_link'
            assign social_url = settings[social_setting]
            assign social_name = social_names[forloop.index0]
            assign social_icon = 'icon-' | append: platform | append: '.svg'
            if platform == 'instagram'
              assign social_url = 'https://www.instagram.com/glorac_silk'
              assign social_icon = 'icon-instagram-footer.svg'
            endif
          -%}
          <li>
            {%- if social_url != blank -%}
              <a class="editorial-footer__social-icon" href="{{ social_url | escape }}" aria-label="{{ social_name }}">
                {{- social_icon | inline_asset_content -}}
              </a>
            {%- else -%}
              <span class="editorial-footer__social-icon" role="img" aria-label="{{ social_name }}">
                {{- social_icon | inline_asset_content -}}
              </span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Editorial footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "link_list", "id": "shop_menu", "label": "Shop menu" },
    { "type": "link_list", "id": "about_menu", "label": "About menu" },
    { "type": "link_list", "id": "customer_care_menu", "label": "Customer care menu" }
  ],
  "presets": [{ "name": "Editorial footer" }]
}
{% endschema %}
