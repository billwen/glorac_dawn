{{ 'section-measuring-guide.css' | asset_url | stylesheet_tag }}

<div class="measuring-guide color-scheme-1 gradient">
  <div class="measuring-guide__page">
    <header class="measuring-guide__header">
      <div class="measuring-guide__logo"><img src="{{ 'measuring-guide-logo.png' | asset_url }}" width="231" height="218" alt="{{ 'measuring_guide.logo_alt' | t | escape }}" loading="eager"></div>
      <p class="measuring-guide__brand">~ GLORAC ~</p>
      <h1>{{ 'measuring_guide.title' | t | escape }}</h1>
      <p class="measuring-guide__intro">{{ 'measuring_guide.intro' | t | escape }}</p>
    </header>
    <section aria-labelledby="BodyMeasurements-{{ section.id }}">
      <h2 class="measuring-guide__divider" id="BodyMeasurements-{{ section.id }}"><span>{{ 'measuring_guide.body_heading' | t | escape }}</span></h2>
      <div class="measuring-guide__body-grid">
        <article class="measuring-guide__body-card">
          <img src="{{ 'measuring-guide-bust.png' | asset_url }}" width="606" height="587" alt="{{ 'measuring_guide.bust_alt' | t | escape }}" loading="eager">
          <div class="measuring-guide__body-copy"><h3>{{ 'measuring_guide.bust' | t | escape }}</h3><p>{{ 'measuring_guide.bust_instruction_html' | t }}</p></div>
        </article>
        <article class="measuring-guide__body-card">
          <img src="{{ 'measuring-guide-waist.png' | asset_url }}" width="604" height="587" alt="{{ 'measuring_guide.waist_alt' | t | escape }}" loading="eager">
          <div class="measuring-guide__body-copy"><h3>{{ 'measuring_guide.waist' | t | escape }}</h3><p>{{ 'measuring_guide.waist_instruction_html' | t }}</p></div>
        </article>
        <article class="measuring-guide__body-card">
          <img src="{{ 'measuring-guide-hips.png' | asset_url }}" width="618" height="587" alt="{{ 'measuring_guide.hips_alt' | t | escape }}" loading="eager">
          <div class="measuring-guide__body-copy"><h3>{{ 'measuring_guide.hips' | t | escape }}</h3><p>{{ 'measuring_guide.hips_instruction_html' | t }}</p></div>
        </article>
      </div>
    </section>
    <section class="measuring-guide__garments" aria-labelledby="GarmentMeasurements-{{ section.id }}">
      <h2 class="measuring-guide__divider" id="GarmentMeasurements-{{ section.id }}"><span>{{ 'measuring_guide.garment_heading' | t | escape }}</span></h2>
      <p class="measuring-guide__instruction">{{ 'measuring_guide.instruction' | t | escape }}</p>
      <div class="measuring-guide__garment-grid">
        <article class="measuring-guide__garment-card">
          <h3>{{ 'measuring_guide.robe' | t | escape }}</h3>
          <div class="measuring-guide__diagram"><img src="{{ 'measuring-guide-robe.png' | asset_url }}" width="615" height="652" alt="{{ 'measuring_guide.robe_alt' | t | escape }}" loading="lazy"></div>
          <ol class="measuring-guide__steps"><li><span>{{ 'measuring_guide.sleeve_length' | t | escape }}</span><p>{{ 'measuring_guide.shoulder_seam_to_cuff' | t | escape }}</p></li><li><span>{{ 'measuring_guide.front_length' | t | escape }}</span><p>{{ 'measuring_guide.shoulder_to_hem' | t | escape }}</p></li></ol>
        </article>
        <article class="measuring-guide__garment-card">
          <h3>{{ 'measuring_guide.slip_dress' | t | escape }}</h3>
          <div class="measuring-guide__diagram"><img src="{{ 'measuring-guide-slip-dress.png' | asset_url }}" width="604" height="636" alt="{{ 'measuring_guide.slip_dress_alt' | t | escape }}" loading="lazy"></div>
          <ol class="measuring-guide__steps"><li><span>{{ 'measuring_guide.bust' | t | escape }}</span><p>{{ 'measuring_guide.across_bust' | t | escape }}</p></li><li><span>{{ 'measuring_guide.hip' | t | escape }}</span><p>{{ 'measuring_guide.across_hip' | t | escape }}</p></li><li><span>{{ 'measuring_guide.front_length' | t | escape }}</span><p>{{ 'measuring_guide.underarm_to_hem' | t | escape }}</p></li></ol>
        </article>
        <article class="measuring-guide__garment-card">
          <h3>{{ 'measuring_guide.skirt' | t | escape }}</h3>
          <div class="measuring-guide__diagram"><img src="{{ 'measuring-guide-skirt.png' | asset_url }}" width="625" height="636" alt="{{ 'measuring_guide.skirt_alt' | t | escape }}" loading="lazy"></div>
          <ol class="measuring-guide__steps"><li><span>{{ 'measuring_guide.waist' | t | escape }}</span><p>{{ 'measuring_guide.across_waistband' | t | escape }}</p></li><li><span>{{ 'measuring_guide.hip' | t | escape }}</span><p>{{ 'measuring_guide.across_hip' | t | escape }}</p></li><li><span>{{ 'measuring_guide.length' | t | escape }}</span><p>{{ 'measuring_guide.edge_to_hem' | t | escape }}</p></li></ol>
        </article>
      </div>
      <div class="measuring-guide__set-grid">
        <article class="measuring-guide__set-card">
          <h3>{{ 'measuring_guide.cami_shorts' | t | escape }}</h3>
          <div class="measuring-guide__set-content">
            <div class="measuring-guide__set-diagram"><img src="{{ 'measuring-guide-cami-shorts.png' | asset_url }}" width="387" height="590" alt="{{ 'measuring_guide.cami_shorts_alt' | t | escape }}" loading="lazy"></div>
            <ol class="measuring-guide__steps"><li><span>{{ 'measuring_guide.chest' | t | escape }}</span><p>{{ 'measuring_guide.below_underarm' | t | escape }}</p></li><li><span>{{ 'measuring_guide.short_waist' | t | escape }}</span><p>{{ 'measuring_guide.across_waistband' | t | escape }}</p></li><li><span>{{ 'measuring_guide.short_hip' | t | escape }}</span><p>{{ 'measuring_guide.below_waistband' | t | escape }}</p></li><li><span>{{ 'measuring_guide.outside_short_length' | t | escape }}</span><p>{{ 'measuring_guide.waistband_to_hem' | t | escape }}</p></li></ol>
          </div>
        </article>
        <article class="measuring-guide__set-card">
          <h3>{{ 'measuring_guide.pajama' | t | escape }}</h3>
          <div class="measuring-guide__set-content">
            <div class="measuring-guide__set-diagram"><img src="{{ 'measuring-guide-pajama.png' | asset_url }}" width="420" height="590" alt="{{ 'measuring_guide.pajama_alt' | t | escape }}" loading="lazy"></div>
            <ol class="measuring-guide__steps"><li><span>{{ 'measuring_guide.chest' | t | escape }}</span><p>{{ 'measuring_guide.below_underarm' | t | escape }}</p></li><li><span>{{ 'measuring_guide.sleeve_length' | t | escape }}</span><p>{{ 'measuring_guide.shoulder_point_to_cuff' | t | escape }}</p></li><li><span>{{ 'measuring_guide.trouser_waist' | t | escape }}</span><p>{{ 'measuring_guide.across_waistband' | t | escape }}</p></li><li><span>{{ 'measuring_guide.trouser_hip' | t | escape }}</span><p>{{ 'measuring_guide.below_waistband' | t | escape }}</p></li><li><span>{{ 'measuring_guide.outside_trouser_length' | t | escape }}</span><p>{{ 'measuring_guide.outside_leg_instruction' | t | escape }}</p></li></ol>
          </div>
        </article>
      </div>
    </section>
    <footer class="measuring-guide__footer">
      <div><p class="measuring-guide__signature">GLORAC</p><p>{{ 'measuring_guide.tagline' | t | escape }}</p></div>
    </footer>
  </div>
</div>

{% schema %}
{
  "name": "Measuring guide",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [],
  "presets": [
    {
      "name": "Measuring guide"
    }
  ]
}
{% endschema %}
