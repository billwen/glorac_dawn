{{ 'section-collection-banners.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .collection-duo__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    padding-bottom: 3.6rem;
  }

  .collection-duo__grid .signature-banner__panel {
    aspect-ratio: 10 / 7;
  }

  .collection-duo__grid .signature-banner__panel::after {
    background: linear-gradient(90deg, rgba(237, 228, 214, 0.9), rgba(237, 228, 214, 0.45) 40%, transparent 75%);
  }

  .collection-duo__grid .signature-banner__content {
    width: 65%;
    padding: clamp(2.4rem, 2.5vw, 4rem);
  }

  .collection-duo__grid .signature-banner__heading {
    font-size: clamp(2.8rem, 2.6vw, 4.4rem);
    line-height: 1.1;
  }

  .collection-duo__grid .signature-banner__text {
    font-size: 1.4rem;
  }

  .collection-duo__grid .signature-banner__button {
    padding-left: 1.6rem;
    padding-right: 1.6rem;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .collection-duo__grid .signature-banner__content {
      width: 90%;
    }
  }

  @media screen and (max-width: 749px) {
    .collection-duo__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .collection-duo__grid .signature-banner__panel {
      aspect-ratio: auto;
    }

    .collection-duo__grid .signature-banner__image {
      aspect-ratio: 10 / 7;
    }

    .collection-duo__grid .signature-banner__content {
      width: 100%;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-duo__grid page-width">
    {%- for block in section.blocks -%}
      {%- liquid
        assign banner_collection = block.settings.collection
        assign banner_image = block.settings.image | default: banner_collection.image | default: banner_collection.featured_image
        assign banner_name = block.settings.name | default: banner_collection.title
        assign banner_url = banner_collection.url
        if banner_url == blank
          assign banner_handle = banner_name | handleize
          assign banner_url = routes.collections_url | append: '/' | append: banner_handle
        endif
      -%}
      <div class="signature-banner__panel" {{ block.shopify_attributes }}>
        {%- if banner_image != blank -%}
          {{
            banner_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1200, 1600',
              sizes: '(min-width: 1600px) 740px, (min-width: 750px) calc((100vw - 12rem) / 2), calc(100vw - 3rem)',
              class: 'signature-banner__image'
          }}
        {%- endif -%}
        <div class="signature-banner__content">
          <p class="signature-banner__label">{{ banner_name | upcase | escape }}</p>
          <h2 class="signature-banner__heading">{{ block.settings.heading | escape }}</h2>
          <p class="signature-banner__text">{{ block.settings.text | escape }}</p>
          <a class="signature-banner__button" href="{{ banner_url | escape }}">
            <span>EXPLORE {{ banner_name | upcase | escape }}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection duo",
  "tag": "section",
  "class": "section",
  "max_blocks": 2,
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection banner",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "name", "label": "Display name" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Collection duo", "blocks": [{ "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
