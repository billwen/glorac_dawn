{%- comment -%}
  Renders a consistently sized flag for the country selector.
  Accepts: country_code
{%- endcomment -%}
<span class="localization-selector__flag" data-country-code="{{ country_code | escape }}" aria-hidden="true">
  {%- case country_code -%}
    {%- when 'SE' -%}
      <svg viewBox="0 0 28 20" width="28" height="20" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
        <path fill="#006AA7" d="M0 0h28v20H0z"/>
        <path fill="#FECC00" d="M8 0h4v20H8z"/>
        <path fill="#FECC00" d="M0 8h28v4H0z"/>
      </svg>
    {%- when 'DK' -%}
      <svg viewBox="0 0 28 20" width="28" height="20" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
        <path fill="#C8102E" d="M0 0h28v20H0z"/>
        <path fill="#FFF" d="M8 0h4v20H8z"/>
        <path fill="#FFF" d="M0 8h28v4H0z"/>
      </svg>
    {%- else -%}
      {{- country_code | escape -}}
  {%- endcase -%}
</span>
