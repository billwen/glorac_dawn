        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Quiet Luxury",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>We are drawn to things that reveal their beauty slowly — natural movement, beautiful fabrics, thoughtful proportions and details that never ask for attention.</p><p>GLORAC is designed for a woman who values how something feels as much as how it looks.</p><p><em>Never overstated. Always considered.</em></p>",
            "text_style": "body"
          }
        }
      },
